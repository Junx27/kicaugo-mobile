#!/bin/sh
# Tolak push langsung ke master.
# Bypass darurat: ALLOW_DIRECT_PUSH=1 git push origin master
# Catatan: hook ini berjalan di sisi klien, bukan proteksi server GitHub.

protected_ref="refs/heads/master"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "$protected_ref" ] || continue

  if [ "${ALLOW_DIRECT_PUSH:-0}" = "1" ]; then
    echo "pre-push: push langsung ke master diizinkan (ALLOW_DIRECT_PUSH=1)." >&2
    continue
  fi

  echo "pre-push: push langsung ke master diblokir." >&2
  echo "          Buat branch fitur, lalu ajukan pull request." >&2
  echo "          Bypass darurat: ALLOW_DIRECT_PUSH=1 git push origin master" >&2
  status=1
done

exit "$status"
